    "Switch": "switch",
    "Gnd": "gnd",
    "GND": "gnd",
    "NET_input": "vbus_in",
    "Net_input": "vbus_in"
  },
  "unmapped_gt_types": [
    "amp",
    "amp_3pin",
    "amp_5pin",
    "ant",
    "battary",
    "bjt",
    "bjt_npn",
    "bjt_pnp",
    "block",
    "buzzer",
    "circle_header",
    "crystal_2pin",
    "crystal_3pin",
    "crystal_4pin",
    "d",
    "dc",
    "esd",
    "fuse",
    "jumper",
    "led",
    "m3螺丝",
    "mosfet",
