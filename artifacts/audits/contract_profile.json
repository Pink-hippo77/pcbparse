{
  "schema_version": "1.0",
  "kind": "contract_profile",
  "profile_id": "public_targets_contract_profile_v2",
  "status": "versioned_with_unresolved",
  "official_schema_version": "official-guide-2026-example-spelling-v1",
  "official_schema_sources": [
    "configs/official_schema.yaml",
    "src/pcbparse/output/official_schema.py:DEFAULT_OFFICIAL_SCHEMA",
    "src/pcbparse/resources/official_schema.json"
  ],
  "official_component_fields": ["type", "Name", "value", "bbox"],
  "official_pin_fields": ["pinname", "point"],
  "official_net_fields": ["hyperGraph", "edges"],
  "type_aliases_gt_to_official": {
    "box": "ic",
