  ],
  "missing_markers": {
    "markers": ["null", "emptyset_prefix_key", "empty_pin_group", "empty_pin_number", "empty_pinname", "empty_string"],
    "null_is_explicit_missing": true,
    "empty_string_is_distinct_from_null": true,
    "emptyset_example_keys": ["∅75", "∅69", "∅73", "∅80", "∅28"],
    "note": "null / emptyset / empty pin number are inventory items; they are not silent normalizations"
  },
  "placeholder_key_policy": {
    "gt_prefix": "emptyset",
    "serializer_output_prefix": "UNKNOWN_",
    "prediction_may_invent_gt_placeholder": false,
    "status": "conflicting",
    "note": "∅75 style keys stay placeholders in the diff; never guessed at prediction time (unobservable from image alone)"
  },
  "pin_number_policy": {
    "empty_allowed_auto_number": true,
    "multi_number_split_on_comma": true,
    "split_function": "pcbparse.output.official_schema.split_official_pin_numbers",
    "status": "confirmed",
    "note": "empty pin number is contract-allowed auto-numbering and is NOT the same problem as unknown component keys"
  },
  "duplicate_designator_policy": {
    "ir_keeps_original_labels": true,
    "serializer_emits": "KEY_1, KEY_2 by natural internal_id order",
    "status": "confirmed"
  },
  "coordinate_policy": {
    "source": "image_top_left_xy",
    "official": "original_bottom_left_xy",
    "transform": "y_out = image_height - y at official boundary only",
    "double_flip_restores_source": true,
    "status": "confirmed"
  },
  "zero_length_edge_policy": {
    "definition": "edge with two identical points",
    "rewrite_all_segments_to_points": false,
    "status": "confirmed"
  },
  "name_spelling_policy": {
    "default": "Name",
    "alternate_allowed": "name",
    "note": "official examples use Name; official prose table says name; keep choice explicit in the profile",
    "status": "confirmed"
  },
  "acceptance": {
    "raw_gt_not_rewritten": true,
    "conflicts_explicit": true,
    "no_guessing_unobservable_ids": true
  }
}
